#!/bin/sh
# bwrap wrapper, used via FLATPAK_BWRAP under rootless Docker only. bwrap cannot bring up loopback in
# a netns nested under rootlesskit's, so flatpak-validate-icon runs without --unshare-net; every other
# call passes through untouched.
case " $* " in
*/flatpak-validate-icon\ *)
  for a in "$@"; do
    shift
    [ "$a" = --unshare-net ] || set -- "$@" "$a"
  done
  ;;
esac
exec /usr/bin/bwrap "$@"
